{
  "name": "virtour",
  "version": "1.0.0",
  "description": "3D Tour with Firebase Availability Management",
  "main": "electron/main.js",
  "author": "Temer Properties",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "init-availability": "node init-availability.js",
    "serve": "npx http-server -p 8080 -c-1",
    "deploy": "firebase deploy --only hosting"
  },
  "keywords": [
    "firebase",
    "realtime-database",
    "availability",
    "pwa",
    "3d-tour"
  ],
  "build": {
    "appId": "com.temer.virtour",
    "productName": "3D Virtual Tour",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "manifest.json",
      "sw.js",
      "tour-data.json",
      "availability-system.js",
      "availability-manager.js",
      "firebase-service.js",
      "auth-manager.js",
      "contact-integration.js",
      "electron/**/*",
      "icon-*.png",
      "project/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "type": "commonjs",
  "dependencies": {
    "firebase-admin": "^11.11.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
